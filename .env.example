# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=3100
BASE_URL=https://divyrs.com
# Long random string: openssl rand -hex 32
SESSION_SECRET=change-me

# Your email: this account gets the /admin page
ADMIN_EMAIL=you@example.com

# Razorpay (https://dashboard.razorpay.com -> Settings -> API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay -> Settings -> Webhooks, URL: https://divyrs.com/billing/webhook, events: payment.captured
RAZORPAY_WEBHOOK_SECRET=

# SMTP for alerts and contact form (Hostinger email works: smtp.hostinger.com, port 465)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@divyrs.com
SMTP_PASS=
MAIL_FROM="Divyrs Systems <no-reply@divyrs.com>"

# Business details shown on legal pages and invoices
BUSINESS_NAME=Divyrs Systems
BUSINESS_ADDRESS=Your registered address, City, State, India
SUPPORT_EMAIL=support@divyrs.com
SUPPORT_PHONE=+91-00000-00000
GSTIN=
# Your state code for GST (MH, DL, KA, ...). With a GSTIN set, 18% GST is added to INR checkouts
# as CGST+SGST for buyers in this state and IGST for others. USD sales are treated as exports.
BUSINESS_STATE=
GST_RATE=18
# Shown in the privacy policy (DPDP Act)
GRIEVANCE_OFFICER=Your Name
GRIEVANCE_EMAIL=grievance@divyrs.com

# ---------------- RegData API (regulatory changes + enforcement actions) ----------------
# Claude API key from https://platform.claude.com (Settings → API keys).
# Without it RegData still runs, but only reads titles (no obligations, deadlines or summaries).
ANTHROPIC_API_KEY=
# Model used to read documents. Opus 5.5 is the most accurate; claude-sonnet-5-5 or claude-haiku-5-5 cost less.
REGDATA_MODEL=claude-opus-5-5
REGDATA_EFFORT=medium
# Safety cap on AI document reads per day (controls spend).
REGDATA_MAX_AI_PER_DAY=300
# How often to check RBI/SEBI feeds (minutes, minimum 5).
REGDATA_COLLECT_MINUTES=30
# Set to 1 to switch off RegData background jobs.
DISABLE_REGDATA=0
