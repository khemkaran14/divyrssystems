<%- include('partials/head') %>
<section class="section" style="padding-top:32px"><div class="container">
  <h1 style="font-size:1.8rem">Admin</h1>
  <p><a class="btn" href="/admin/regdata">RegData admin: feeds, review queue, API customers →</a></p>
  <% if (msg) { %><div class="alert success"><%= msg %></div><% } %>
  <div class="grid grid-4">
    <div class="card"><div class="muted small">Users</div><div class="stat"><%= stats.users %></div></div>
    <div class="card"><div class="muted small">Paying now</div><div class="stat"><%= stats.paying %></div></div>
    <div class="card"><div class="muted small">Revenue this month</div><div class="stat" style="font-size:1.3rem"><%= stats.revenue.length ? stats.revenue.map(r => formatPrice(r.total, r.currency)).join(' + ') : '—' %></div></div>
    <div class="card"><div class="muted small">Monitors / links</div><div class="stat"><%= stats.monitors %> / <%= stats.links %></div></div>
    <div class="card"><div class="muted small">Business cards</div><div class="stat"><%= stats.cards %></div></div>
    <div class="card"><div class="muted small">Forms</div><div class="stat"><%= stats.forms %></div></div>
    <div class="card"><div class="muted small">Bookings</div><div class="stat"><%= stats.bookings %></div></div>
  </div>

  <h2 style="font-size:1.3rem;margin-top:36px">Traffic (last 30 days)</h2>
  <div class="grid grid-3">
    <div class="card"><div class="muted small">Page views</div><div class="stat"><%= traffic.total.toLocaleString('en-IN') %></div></div>
    <div class="card"><div class="muted small">Sign-ups</div><div class="stat"><%= traffic.signups %></div><div class="small muted"><%= traffic.total ? (100 * traffic.signups / traffic.total).toFixed(1) + '% of views' : '' %></div></div>
    <div class="card"><div class="muted small">Digest &amp; newsletter subscribers</div><div class="stat"><%= traffic.subscribers %></div></div>
  </div>
  <% const maxV = Math.max(1, ...traffic.days.map(d => d.v)); %>
  <div class="card" style="margin-top:16px">
    <div style="display:flex;align-items:flex-end;gap:3px;height:120px">
      <% for (const d of traffic.days) { %><div title="<%= d.day %>: <%= d.v %> views" style="flex:1;background:var(--brand);border-radius:3px 3px 0 0;height:<%= Math.max(2, 100 * d.v / maxV) %>%"></div><% } %>
      <% if (!traffic.days.length) { %><p class="muted small">No visits recorded yet.</p><% } %>
    </div>
    <div class="table-wrap" style="margin-top:14px"><table><thead><tr><th>Page</th><th class="num">Views</th></tr></thead>
      <tbody><% for (const t of traffic.top) { %><tr><td class="mono small"><%= t.path %></td><td class="num"><%= t.v %></td></tr><% } %></tbody></table></div>
  </div>

  <h2 style="font-size:1.3rem;margin-top:36px">Users (latest 100)</h2>
  <div class="card table-wrap" style="padding:8px"><table>
    <thead><tr><th>Name</th><th>Email</th><th>Plan</th><th>Joined</th><th>Set plan manually</th></tr></thead>
    <tbody><% for (const u of users) { const active = u.plan !== 'free' && u.plan_expires > Date.now(); %>
      <tr><td><%= u.name %></td><td><%= u.email %></td>
        <td><%= active ? PLANS[u.plan].name + ' → ' + new Date(u.plan_expires).toLocaleDateString('en-IN') : 'Free' %></td>
        <td class="small"><%= new Date(u.created_at).toLocaleDateString('en-IN') %></td>
        <td><form method="post" action="/admin/users/<%= u.id %>/plan" style="display:flex;gap:6px">
          <select name="plan" style="width:auto"><option value="free">Free</option><option value="pro">Pro</option><option value="business">Business</option></select>
          <input name="days" type="number" value="30" min="0" style="width:80px" title="Days">
          <button class="btn sm" type="submit">Set</button></form></td></tr>
    <% } %></tbody>
  </table></div>

  <h2 style="font-size:1.3rem;margin-top:36px">Payments</h2>
  <div class="card table-wrap" style="padding:8px"><table>
    <thead><tr><th>Date</th><th>User</th><th>Plan</th><th class="num">Amount</th><th>Payment ID</th></tr></thead>
    <tbody><% for (const p of payments) { %>
      <tr><td class="small"><%= new Date(p.paid_at).toLocaleString('en-IN') %></td><td><%= p.email %></td><td><%= p.plan %> · <%= p.months %>mo</td><td class="num"><%= formatPrice(p.amount, p.currency) %></td><td class="mono small"><%= p.payment_id %></td></tr>
    <% } %><% if (!payments.length) { %><tr><td colspan="5" class="muted">No payments yet.</td></tr><% } %></tbody>
  </table></div>

  <h2 style="font-size:1.3rem;margin-top:36px">Contact messages</h2>
  <div class="grid">
    <% for (const m of messages) { %>
      <div class="card"><strong><%= m.name %></strong> <% if (m.topic) { %><span class="badge"><%= m.topic %></span> <% } %><span class="muted small">&lt;<%= m.email %>&gt; <%= m.company ? '· ' + m.company : '' %><%= m.phone ? ' · ' + m.phone : '' %> · <%= new Date(m.created_at).toLocaleString('en-IN') %></span>
        <p style="white-space:pre-line;margin:8px 0 0"><%= m.body %></p></div>
    <% } %>
    <% if (!messages.length) { %><p class="muted">No messages yet.</p><% } %>
  </div>
</div></section>
<%- include('partials/foot') %>
