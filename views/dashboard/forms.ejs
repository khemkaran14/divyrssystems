<%- include('../partials/head') %>
<div class="container dash">
  <%- include('../partials/dash-side') %>
  <div>
    <h1 style="font-size:1.8rem">Forms</h1>
    <p class="muted">Add a working contact form to any website — no server code. Every submission is saved here and emailed to you.
      <br><%= forms.length %> of <%= plan.limits.forms %> forms · <%= plan.limits.formSubmissionsMonth === Infinity ? 'unlimited' : plan.limits.formSubmissionsMonth %> submissions/month</p>
    <% if (error) { %><div class="alert error"><%= error %> <% if (/Upgrade/.test(error)) { %><a href="/pricing">See plans</a><% } %></div><% } %>
    <form class="card inline-form" method="post" action="/dashboard/forms" style="margin-bottom:24px">
      <div class="field"><label for="f-name">Form name</label><input id="f-name" name="name" placeholder="Website contact form" maxlength="80"></div>
      <div class="field"><label for="f-mail">Send submissions to</label><input id="f-mail" name="notify_email" type="email" value="<%= user.email %>"></div>
      <div class="field"><label for="f-redir">Thank-you page (optional)</label><input id="f-redir" name="redirect_url" placeholder="https://yoursite.com/thanks"></div>
      <button class="btn primary" type="submit">Create form</button>
    </form>
    <% for (const f of forms) { const action = baseUrl + '/f/' + f.key; %>
      <div class="card" style="margin-bottom:16px">
        <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap">
          <div><strong><%= f.name %></strong><div class="small muted">→ <%= f.notify_email %> · <%= f.total %> total · <%= f.month %> this month</div></div>
          <div class="btn-row">
            <a class="btn sm primary" href="/dashboard/forms/<%= f.id %>">View submissions</a>
            <form method="post" action="/dashboard/forms/<%= f.id %>/delete" onsubmit="return confirm('Delete this form and all its submissions?')"><button class="btn sm danger" type="submit">Delete</button></form>
          </div>
        </div>
        <details style="border:none;padding:8px 0 0"><summary class="small">Show HTML code to paste into your website</summary>
<pre>&lt;form action="<%= action %>" method="POST"&gt;
  &lt;input name="name" placeholder="Your name" required&gt;
  &lt;input name="email" type="email" placeholder="Email" required&gt;
  &lt;input name="phone" placeholder="Phone"&gt;
  &lt;textarea name="message" placeholder="Message"&gt;&lt;/textarea&gt;
  &lt;input name="_gotcha" style="display:none" tabindex="-1" autocomplete="off"&gt;
  &lt;button type="submit"&gt;Send&lt;/button&gt;
&lt;/form&gt;</pre>
          <p class="small muted">Any field names work. The hidden <code>_gotcha</code> field blocks spam bots. For JavaScript/AJAX, POST JSON with header <code>Accept: application/json</code>.</p>
        </details>
      </div>
    <% } %>
    <% if (!forms.length) { %><p class="muted">No forms yet.</p><% } %>
  </div>
</div>
<%- include('../partials/foot') %>
