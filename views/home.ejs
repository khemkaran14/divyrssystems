<%- include('partials/head') %>
<section class="hero center">
  <div class="container">
    <span class="badge">Free plan · No credit card</span>
    <h1 style="margin-top:16px">Everyday business tools,<br><span>without the enterprise price</span></h1>
    <p class="lead">GST invoices and quotations, an online booking page, a digital business card, website forms, uptime &amp; SSL alerts, short links and QR codes — all from one simple dashboard built for freelancers, professionals and growing companies.</p>
    <div class="btn-row">
      <a class="btn primary lg" href="/signup">Create free account</a>
      <a class="btn lg" href="/tools/invoice">Try the invoice maker →</a>
    </div>
    <div class="trust">
      <span>🇮🇳 GST-ready invoices</span><span>📅 Online bookings</span><span>⏱ 1-minute uptime checks</span><span>💳 Pay in ₹ or $</span><span>🔒 Your data stays yours</span>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="center" style="margin-bottom:36px">
      <h2>Your business toolkit. One login.</h2>
      <p class="lead">Start with any of them for free. Upgrade only when you need more.</p>
    </div>
    <div class="grid grid-4">
      <a class="card" href="/tools/invoice"><div class="icon">🧾</div><h3>Invoices &amp; Quotations</h3><p class="muted small">GST invoices, quotations, proforma and receipts with CGST/SGST/IGST and PDF download.</p></a>
      <a class="card" href="/tools/booking"><div class="icon">📅</div><h3>Booking Page</h3><p class="muted small">Clients book a free slot with you online. Confirmation emails for both sides.</p></a>
      <a class="card" href="/tools/business-card"><div class="icon">🪪</div><h3>Digital Business Card</h3><p class="muted small">Call, WhatsApp, UPI pay and "Save contact" on one link, with a printable QR code.</p></a>
      <a class="card" href="/tools/uptime"><div class="icon">📡</div><h3>Uptime &amp; SSL Monitor</h3><p class="muted small">Checks every minute. Email alerts when a site goes down or its SSL is about to expire.</p></a>
      <a class="card" href="/tools/forms"><div class="icon">📨</div><h3>Website Forms</h3><p class="muted small">Contact and lead forms for any website. Every submission emailed and saved.</p></a>
      <a class="card" href="/tools/links"><div class="icon">🔗</div><h3>Link Shortener</h3><p class="muted small">Short links with click counts for WhatsApp, Instagram, SMS and print.</p></a>
      <a class="card" href="/tools/qr"><div class="icon">▦</div><h3>QR Code Generator</h3><p class="muted small">PNG and SVG QR codes for links, UPI and Wi-Fi. Free forever.</p></a>
      <a class="card" href="/tools"><div class="icon">％</div><h3>GST &amp; EMI Calculators</h3><p class="muted small">Quick free calculators for everyday business maths.</p></a>
    </div>
  </div>
</section>

<section class="section soft">
  <div class="container">
    <div class="center" style="margin-bottom:36px"><h2>Who uses Divyrs</h2></div>
    <div class="grid grid-3">
      <div class="card"><h3>Freelancers &amp; consultants</h3><p class="muted">Let clients book calls online, send quotations and invoices in minutes, and share a digital card that looks bigger than you are.</p></div>
      <div class="card"><h3>Web agencies &amp; developers</h3><p class="muted">Monitor uptime and SSL for every client site, add working contact forms without a backend, and share white-label status pages.</p></div>
      <div class="card"><h3>Shops &amp; small companies</h3><p class="muted">GST billing without expensive software, digital cards for your sales team, UPI QR codes for your counter, and alerts if your store goes down.</p></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="center" style="margin-bottom:36px">
      <h2>Simple pricing</h2>
      <p class="lead">Free to start. Pro is less than a cup of coffee a week.</p>
    </div>
    <div class="grid grid-3">
      <% for (const p of Object.values(PLANS)) { %>
      <div class="card price-card <%= p.id === 'pro' ? 'featured' : '' %>">
        <h3><%= p.name %></h3>
        <p class="muted small"><%= p.tagline %></p>
        <div class="price"><%= formatPrice(p.price[cur], cur) %><small> /month</small></div>
        <ul class="checks">
          <li><%= p.limits.monitors %> uptime monitors</li>
          <li><%= p.limits.links === Infinity ? 'Unlimited' : p.limits.links %> short links</li>
          <li><%= p.limits.savedInvoices === Infinity ? 'Unlimited saved invoices' : p.limits.savedInvoices + ' saved invoices' %></li>
          <li><%= p.limits.bookingsMonth === Infinity ? 'Unlimited' : p.limits.bookingsMonth %> bookings a month</li>
          <li><%= p.limits.cards %> digital business card<%= p.limits.cards > 1 ? 's' : '' %></li>
        </ul>
        <a class="btn <%= p.id === 'pro' ? 'primary' : '' %> block" href="<%= p.id === 'free' ? '/signup' : '/pricing' %>"><%= p.id === 'free' ? 'Start free' : 'See details' %></a>
      </div>
      <% } %>
    </div>
  </div>
</section>

<section class="section soft">
  <div class="container" style="max-width:780px">
    <h2 class="center">Questions</h2>
    <details><summary>Is the free plan really free?</summary><p>Yes. No card needed, no time limit. You get a booking page (20 bookings a month), a digital business card, 1 website form, 2 uptime monitors, 10 short links, 3 saved invoices, and unlimited invoices, QR codes and calculators.</p></details>
    <details><summary>Can I pay in rupees?</summary><p>Yes. Indian customers pay in INR by UPI, cards, net banking or wallets through Razorpay. International customers pay in USD by card.</p></details>
    <details><summary>Do I get a GST invoice for my subscription?</summary><p>A payment receipt is emailed right after you pay. Contact us with your company name and GSTIN for a GST tax invoice.</p></details>
    <details><summary>Can I cancel any time?</summary><p>Plans are prepaid monthly or yearly with no auto-renewal. If you don't renew, your account simply returns to the Free plan.</p></details>
    <details><summary>Do you offer custom plans for companies?</summary><p>Yes — more monitors, team access, custom domains or on-premise setup. <a href="/contact">Talk to us</a>.</p></details>
  </div>
</section>

<section class="section center">
  <div class="container">
    <h2>Start in 30 seconds</h2>
    <p class="lead">One account for all tools. Upgrade, downgrade or stay free — your choice.</p>
    <div class="btn-row"><a class="btn primary lg" href="/signup">Create free account</a></div>
  </div>
</section>
<%- include('partials/foot') %>
