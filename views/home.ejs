<%- include('partials/head') %>
<% if (deleted) { %><div class="container" style="margin-top:16px"><div class="alert success">Your account has been deleted.</div></div><% } %>
<section class="hero"><div class="container">
  <div class="grid grid-2" style="align-items:center;gap:40px">
    <div>
      <span class="badge">Divyrs Systems · Regulatory data for India</span>
      <h1 style="margin-top:14px">Know every new rule <span>the day it's published</span></h1>
      <p class="lead">The RegData API turns RBI and SEBI circulars, directions, penalties and orders into structured data: obligations, deadlines, who it applies to and who was penalised. Built for compliance teams, lenders and the software they use.</p>
      <div class="btn-row">
        <a class="btn primary lg" href="/regdata">Explore RegData API</a>
        <a class="btn lg" href="/contact?topic=demo">Book a demo</a>
      </div>
      <p class="small muted" style="margin-top:14px">Free developer key · Official sources only · Pay in ₹ or $</p>
    </div>
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px"><strong>Live from the regulators</strong><a class="small" href="/regdata/changes">All changes →</a></div>
      <% if (!latest.length) { %><p class="muted small">Feeds are being processed. New items appear here within minutes.</p><% } %>
      <% for (const d of latest) { %>
        <a href="/regdata/changes/<%= d.id %>" style="display:block;padding:10px 0;border-top:1px solid var(--line);color:inherit">
          <div class="small muted"><span class="badge"><%= d.regulator %></span> <%= new Date(d.published_at).toLocaleDateString('en-IN') %><% if (d.impact === 'high') { %> · <span class="badge bad">high impact</span><% } %><% if (d.is_enforcement) { %> · <span class="badge warn">enforcement</span><% } %></div>
          <div style="font-weight:600;font-size:.95rem;margin-top:2px"><%= d.title %></div>
        </a>
      <% } %>
    </div>
  </div>
  <div class="trust" style="justify-content:flex-start">
    <span>📜 <%= stats.documents.toLocaleString('en-IN') %> documents processed</span>
    <span>⚖️ <%= stats.actions.toLocaleString('en-IN') %> enforcement actions</span>
    <span>⏱ Feeds checked every 30 minutes</span>
    <span>🔔 Webhooks &amp; watchlists</span>
  </div>
</div></section>

<section class="section"><div class="container">
  <div class="center" style="margin-bottom:32px"><h2>What RegData gives you</h2><p class="lead">Two APIs with one key, plus pages your whole team can use.</p></div>
  <div class="grid grid-3">
    <div class="card"><div class="icon">📜</div><h3>Regulatory changes</h3><p class="muted small">Every new circular and direction with a summary, obligations, deadlines, effective date, affected entity types and the earlier rules it amends, each tied to the page of the official PDF.</p></div>
    <div class="card"><div class="icon">⚖️</div><h3>Enforcement actions</h3><p class="muted small">Penalties, adjudication and settlement orders, licence cancellations and restrictions, searchable by company or person with fuzzy name matching.</p></div>
    <div class="card"><div class="icon">🔔</div><h3>Alerts &amp; screening</h3><p class="muted small">Webhooks when something relevant is published, watchlists for names you care about, and bulk screening of up to 100 vendors or borrowers per call.</p></div>
  </div>
  <div class="center" style="margin-top:28px"><div class="btn-row"><a class="btn primary" href="/regdata#pricing">See API pricing</a><a class="btn" href="/regdata/docs">Read the docs</a><a class="btn" href="/regdata/enforcement">Search enforcement actions</a></div></div>
</div></section>

<section class="section soft"><div class="container">
  <div class="center" style="margin-bottom:32px"><h2>Who it's for</h2></div>
  <div class="grid grid-4">
    <div class="card"><h3>Banks &amp; NBFCs</h3><p class="muted small">Never miss an RBI direction. Give auditors a record of every change and when you acted.</p></div>
    <div class="card"><h3>Brokers, AMCs &amp; fintechs</h3><p class="muted small">Track SEBI circulars and check partners and vendors against enforcement orders.</p></div>
    <div class="card"><h3>Software vendors</h3><p class="muted small">Embed regulatory updates and enforcement checks in your GRC, lending or onboarding product.</p></div>
    <div class="card"><h3>Law &amp; advisory firms</h3><p class="muted small">Brief every client the same day, filtered to the sectors they're in.</p></div>
  </div>
</div></section>

<section class="section"><div class="container">
  <div class="center" style="margin-bottom:32px">
    <h2>Also from Divyrs: business tools</h2>
    <p class="lead">Free to start, for freelancers, professionals and small teams. Same account.</p>
  </div>
  <div class="grid grid-4">
    <a class="card" href="/tools/invoice"><div class="icon">🧾</div><h3>Invoices &amp; Quotations</h3><p class="muted small">GST invoices, quotations, proforma and receipts as PDF.</p></a>
    <a class="card" href="/tools/booking"><div class="icon">📅</div><h3>Booking Page</h3><p class="muted small">Clients book a free slot with you; both get an email.</p></a>
    <a class="card" href="/tools/business-card"><div class="icon">🪪</div><h3>Digital Business Card</h3><p class="muted small">Call, WhatsApp, UPI and "Save contact" on one link.</p></a>
    <a class="card" href="/tools/uptime"><div class="icon">📡</div><h3>Uptime &amp; SSL Monitor</h3><p class="muted small">Alerts when a site goes down or its SSL nears expiry.</p></a>
    <a class="card" href="/tools/forms"><div class="icon">📨</div><h3>Website Forms</h3><p class="muted small">Contact forms for any site, emailed and saved.</p></a>
    <a class="card" href="/tools/links"><div class="icon">🔗</div><h3>Link Shortener</h3><p class="muted small">Short links with click counts.</p></a>
    <a class="card" href="/tools/qr"><div class="icon">▦</div><h3>QR Code Generator</h3><p class="muted small">PNG and SVG for links, UPI and Wi-Fi.</p></a>
    <a class="card" href="/tools"><div class="icon">％</div><h3>GST &amp; EMI Calculators</h3><p class="muted small">Quick free calculators.</p></a>
  </div>
  <div class="center" style="margin-top:24px"><a class="btn" href="/pricing#tools">Tool plans from <%= formatPrice(PLANS.pro.price[cur], cur) %>/month</a></div>
</div></section>

<section class="section soft"><div class="container" style="max-width:780px">
  <h2 class="center">Questions</h2>
  <details><summary>Where does RegData's information come from?</summary><p>Only official regulator publications. Every record links to the source document so your team can check the original.</p></details>
  <details><summary>Can I try it before paying?</summary><p>Yes. The free developer plan gives 100 API calls a month on data delayed by 7 days. <a href="/contact?topic=demo">Ask us</a> for a full-access trial for your team.</p></details>
  <details><summary>Do you give GST invoices?</summary><p>Yes. Every payment has a downloadable invoice; add your company name and GSTIN in Account → Billing details.</p></details>
  <details><summary>Can we pay by bank transfer or sign an annual contract?</summary><p>Yes, for Enterprise and annual plans. <a href="/contact?topic=enterprise">Contact us</a>.</p></details>
  <details><summary>Is my data safe?</summary><p>See our <a href="/security">security page</a> and <a href="/privacy">privacy policy</a>. You can download or delete your data at any time from your account.</p></details>
</div></section>

<section class="section center"><div class="container">
  <h2>Start with a free API key</h2>
  <p class="lead">Set up in two minutes. Talk to us when you're ready for your whole team.</p>
  <div class="btn-row"><a class="btn primary lg" href="<%= user ? '/dashboard/regdata' : '/signup?next=/dashboard/regdata' %>">Get free API key</a><a class="btn lg" href="/contact?topic=enterprise">Talk to sales</a></div>
</div></section>
<%- include('partials/foot') %>
