<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> | Divyrs Systems</title>
<meta name="description" content="<%= description || 'Divyrs Systems: the RegData API for RBI and SEBI regulatory changes and enforcement actions, plus GST invoices, booking pages, digital business cards and uptime monitoring for Indian businesses.' %>">
<meta property="og:title" content="<%= title %> | Divyrs Systems">
<meta property="og:type" content="website">
<meta property="og:url" content="<%= baseUrl + path %>">
<meta property="og:description" content="<%= description || 'Regulatory data API and business tools for India.' %>">
<meta property="og:image" content="<%= baseUrl %>/og.png">
<meta name="twitter:card" content="summary_large_image">
<link rel="canonical" href="<%= baseUrl + path %>">
<script type="application/ld+json"><%- json({ '@context': 'https://schema.org', '@type': 'Organization', name: business.name, url: baseUrl, logo: baseUrl + '/favicon.svg', email: business.email }) %></script>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="nav">
  <div class="container">
    <a class="logo" href="/"><span class="logo-mark">D</span> Divyrs Systems</a>
    <button class="nav-toggle" aria-label="Menu" onclick="document.querySelector('.nav-links').classList.toggle('open')">☰</button>
    <nav class="nav-links">
      <a href="/regdata" class="<%= path.startsWith('/regdata') ? 'active' : '' %>">RegData API</a>
      <a href="/tools" class="<%= path.startsWith('/tools') ? 'active' : '' %>">Tools</a>
      <a href="/pricing" class="<%= path === '/pricing' ? 'active' : '' %>">Pricing</a>
      <a href="/about" class="<%= path === '/about' ? 'active' : '' %>">About</a>
      <a href="/contact" class="<%= path === '/contact' ? 'active' : '' %>">Contact</a>
      <% if (user) { %>
        <% if (isAdmin) { %><a href="/admin">Admin</a><% } %>
        <a class="btn primary sm" href="/dashboard">Dashboard</a>
      <% } else { %>
        <a href="/login">Log in</a>
        <a class="btn primary sm" href="/signup">Start free</a>
      <% } %>
    </nav>
  </div>
</header>
<main>
