<%- include('../partials/head') %>
<section class="section center"><div class="container" style="max-width:560px">
  <div class="card">
    <% if (!ok) { %>
      <h1 style="font-size:1.6rem">Hmm</h1><div class="alert error"><%= error %></div>
    <% } else if (mode === 'pending') { %>
      <h1 style="font-size:1.6rem">📬 Check your inbox</h1><p class="muted">We sent you a link to confirm your subscription. The Roundup arrives every Monday at 8am IST.</p>
    <% } else if (mode === 'confirmed') { %>
      <h1 style="font-size:1.6rem">✅ You're subscribed</h1><p class="muted">The first Roundup arrives next Monday at 8am IST.</p>
    <% } else { %>
      <h1 style="font-size:1.6rem">You're unsubscribed</h1><p class="muted">You won't get these emails any more.</p>
    <% } %>
    <div class="btn-row" style="justify-content:center;margin-top:12px"><a class="btn" href="/regdata/changes">Browse latest changes</a><a class="btn primary" href="/regdata">RegData API</a></div>
  </div>
</div></section>
<%- include('../partials/foot') %>
